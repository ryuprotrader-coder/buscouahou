---
import '../../styles/globals.css';
import RegisterForm from '../../components/auth/RegisterForm';
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criar Conta — Mais Melhor</title>
    <meta name="description" content="Crie sua conta gratuita no Mais Melhor e descubra as melhores ofertas perto de você." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Fundo gradiente animado -->
    <div class="auth-bg">
      <div class="auth-blob auth-blob-1"></div>
      <div class="auth-blob auth-blob-2"></div>
      <div class="auth-blob auth-blob-3"></div>
    </div>

    <main class="auth-layout">
      <!-- Branding lateral (desktop) -->
      <aside class="auth-branding">
        <div class="branding-content">
          <div class="brand-logo">
            <span class="brand-icon">🛍️</span>
          </div>
          <h2 class="brand-headline">
            Junte-se ao<br />
            <span class="brand-highlight">Mais Melhor</span>
          </h2>
          <p class="brand-sub">
            Crie sua conta grátis e comece a aproveitar as melhores ofertas da sua cidade agora mesmo.
          </p>
          <ul class="brand-benefits">
            <li>✅ Acesso a promoções exclusivas</li>
            <li>✅ Notificações de ofertas próximas</li>
            <li>✅ Histórico de pedidos e favoritos</li>
            <li>✅ Cadastro 100% gratuito</li>
          </ul>
        </div>
      </aside>

      <!-- Formulário -->
      <section class="auth-form-side">
        <RegisterForm client:load />
      </section>
    </main>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', sans-serif;
        min-height: 100dvh;
        background: #0a0a0f;
        overflow-x: hidden;
      }

      .auth-bg {
        position: fixed; inset: 0; z-index: 0;
        background: radial-gradient(ellipse at 20% 50%, #1a0a00 0%, #0a0a0f 70%);
      }
      .auth-blob {
        position: absolute; border-radius: 50%;
        filter: blur(80px); opacity: 0.35;
        animation: float 8s ease-in-out infinite alternate;
      }
      .auth-blob-1 {
        width: 500px; height: 500px; left: -10%; top: -10%;
        background: radial-gradient(circle, #ff6b00 0%, transparent 70%);
        animation-delay: 0s;
      }
      .auth-blob-2 {
        width: 400px; height: 400px; right: -5%; bottom: 0;
        background: radial-gradient(circle, #ff9500 0%, transparent 70%);
        animation-delay: 3s;
      }
      .auth-blob-3 {
        width: 300px; height: 300px; left: 40%; top: 60%;
        background: radial-gradient(circle, #7c2d00 0%, transparent 70%);
        animation-delay: 6s;
      }
      @keyframes float {
        from { transform: translate(0, 0) scale(1); }
        to   { transform: translate(30px, -20px) scale(1.08); }
      }

      .auth-layout {
        position: relative; z-index: 1;
        display: grid;
        grid-template-columns: 1fr;
        min-height: 100dvh;
        align-items: center;
        justify-items: center;
        padding: 2rem 1rem;
      }
      @media (min-width: 1024px) {
        .auth-layout { grid-template-columns: 1fr 1fr; padding: 0; }
      }

      .auth-branding {
        display: none;
        padding: 3rem;
        align-items: center;
        justify-content: center;
      }
      @media (min-width: 1024px) { .auth-branding { display: flex; } }
      .branding-content { max-width: 420px; }

      .brand-logo {
        width: 72px; height: 72px;
        background: linear-gradient(135deg, #ff6b00, #ff9500);
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        box-shadow: 0 0 40px rgba(255,107,0,.4);
        margin-bottom: 2rem;
      }
      .brand-headline {
        font-size: 2.8rem; font-weight: 800; color: #fff;
        line-height: 1.15; margin-bottom: 1rem;
      }
      .brand-highlight { color: #ff6b00; }
      .brand-sub { color: rgba(255,255,255,.55); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem; }

      .brand-benefits { list-style: none; display: flex; flex-direction: column; gap: .75rem; }
      .brand-benefits li { color: rgba(255,255,255,.7); font-size: .95rem; }

      .auth-form-side {
        display: flex; align-items: center; justify-content: center;
        width: 100%; padding: 2rem;
      }
      @media (min-width: 1024px) {
        .auth-form-side {
          background: rgba(0,0,0,.3);
          backdrop-filter: blur(4px);
          border-left: 1px solid rgba(255,255,255,.06);
          min-height: 100dvh;
          overflow-y: auto;
          padding: 3rem 2rem;
        }
      }
    </style>
  </body>
</html>
